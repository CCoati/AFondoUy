# Copiar a .env.local. No guardar secretos en Git.
# URL canónica HTTPS en producción. Netlify también detecta URL automáticamente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Ambas variables son necesarias para conectar Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca agregar NEXT_PUBLIC_ a esta clave.
SUPABASE_SERVICE_ROLE_KEY=
# Usar un proyecto de pruebas con todas las migraciones aplicadas.
RESERVATIONS_ENABLED=false
# Checkout Pro solo se habilita con modo sandbox y credencial TEST-. No hay modo productivo.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_EXPECTED_COLLECTOR_ID=
# Solo para el cron externo que llama a la conciliación, 32+ caracteres aleatorios.
PAYMENT_RECONCILIATION_SECRET=
# Solo servidor: firmar enlaces de consulta entregados al correo participante (>=32 caracteres aleatorios).
ORDER_LOOKUP_SECRET=
# Resend transaccional: verificar el dominio remitente antes de enviar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opcional: correo interno para incidentes críticos (no recibe datos personales).
ADMIN_ALERT_EMAIL=
